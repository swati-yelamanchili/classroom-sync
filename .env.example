# Copy to .env (npm run setup reads it).

# SQLite file, resolved relative to server/prisma/. Change the Prisma provider to move to PostgreSQL.
DATABASE_URL="file:./dev.db"

# Port for the API and Socket.IO server. (PORT is honoured if this is unset, as hosting platforms set it.)
API_PORT=4000

# Passcode teachers enter to sign in. CHANGE THIS outside local demos.
TEACHER_PASSCODE="classroom-demo"

# Secret used to sign teacher session cookies. Use a long random string outside local demos:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="local-development-secret-change-me"

# Browser origins allowed to call the API (comma separated). Only needed when the client
# is served from a different origin than the API.
CLIENT_ORIGINS="http://localhost:5173"

# Set to "true" when served over HTTPS so the auth cookie is marked Secure.
COOKIE_SECURE="false"

# Base address for student links, e.g. "https://classroom.example.org". Leave empty to detect the
# computer's network address automatically.
PUBLIC_BASE_URL=""

# Stage 3 placeholder. No model is implemented; leave disabled. See FUTURE_SCOPE.md.
TOPIC_RECOGNITION_PROVIDER="disabled"
